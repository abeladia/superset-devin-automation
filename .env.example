# ── Required ─────────────────────────────────────────────────────────────────

# Devin personal API key (starts with apk_user_)
# Get from: https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=apk_user_...

# GitHub personal access token with repo + issues scopes
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# ── Optional ─────────────────────────────────────────────────────────────────

# Secret for verifying GitHub webhook signatures (recommended for production)
# Set this to the same value you enter in GitHub → Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=

# The label that triggers Devin (default: devin-fix)
TRIGGER_LABEL=devin-fix

# The GitHub repo to operate on (default: abeladia/superset_update)
TARGET_REPO=abeladia/superset_update

# Path to SQLite database file inside the container
DB_PATH=/data/sessions.db
